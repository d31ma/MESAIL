[Unit]
Description=Reject untranslated Kubernetes service traffic leaving the VM, and K3s ports arriving from outside it (MESAIL deploy/k3s/node, as d31ma/PaaS apps/k3s-pilot)
Before=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/mesail-service-cidr-guard.nft

[Install]
WantedBy=multi-user.target
